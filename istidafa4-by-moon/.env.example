# TELEGRAM_BOT_TOKEN: token du bot Telegram (recommandé : le définir ici / dans
# les variables d'environnement de la plateforme plutôt que dans le code).
TELEGRAM_BOT_TOKEN="put-your-own-bot-token-here"

# ADMIN_IDS: IDs Telegram des administrateurs, séparés par des virgules.
ADMIN_IDS="1726923679"

# APP_URL: (optionnel) URL/domaine public de l'application. S'il est vide, le
# domaine est détecté automatiquement à la première requête reçue (en-tête
# Host / X-Forwarded-Host) et utilisé par le keep-alive automatique.
APP_URL=""

# PORT: injecté automatiquement par la plateforme. Défaut : 8080.
# PORT="8080"

# KEEP_ALIVE_INTERVAL: secondes entre deux pings automatiques (défaut : 30).
# KEEP_ALIVE_INTERVAL="30"

# DATA_DIR: dossier des données persistantes (scripts, domaine détecté...).
# Monter un volume persistant dessus (ex. /app/data).
# DATA_DIR="/app/data"
